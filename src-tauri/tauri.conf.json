{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TurboDM",
  "version": "1.0.0",
  "identifier": "com.turbodm.downloader",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "TurboDM", "width": 960, "height": 620, "minWidth": 360, "minHeight": 500 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
