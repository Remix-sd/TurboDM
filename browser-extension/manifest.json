{
  "manifest_version": 3,
  "name": "TurboDM Browser Integration",
  "version": "1.0.0",
  "description": "التقاط التحميلات ومقاطع الفيديو وإرسالها إلى برنامج TurboDM",
  "permissions": ["downloads", "cookies", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true }],
  "browser_specific_settings": { "gecko": { "id": "extension@turbodm.app" } }
}
